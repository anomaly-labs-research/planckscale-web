  "engines": {
    "bun": ">=1.1.0"
  },
  "dependencies": {
    "next": "15.5.7",
    "react": "19.1.2",
    "react-dom": "19.1.2"
  },
  "devDependencies": {
    "@types/node": "22.10.5",
    "@types/react": "19.1.8",
    "@types/react-dom": "19.1.6",
    "typescript": "5.7.3"
  }
}
